#######################################################################
# 存储节点部署前检查配置
#######################################################################
# 节点登录信息
# 格式：管理IP SSH用户名 SSH密码 IPMI_IP IPMI用户名 IPMI密码 role
# role 仅支持 storage 或 compute，普通检查和硬盘测试只作用于 storage
# SSH用户名第一版只支持 root
# 如果使用 SSH 免密，SSH密码可以填写 -
#######################################################################
NODES=(
    10.10.16.82 root xsky@2025 10.10.6.82 admin Password@_ storage
    #10.10.17.75 root xsky@2025 10.10.7.75 admin Password@_ storage
    #10.10.17.76 root xsky@2025 10.10.7.76 admin Password@_ storage
)

#######################################################################
# RDMA 网络测试网段
# 只填写需要执行 RDMA 性能测试的存储网段，避免误测 TCP/业务网络
# 格式：net名称:CIDR
#######################################################################
STORNETS=(
    net1:10.10.147.0/24
    net2:10.10.148.0/24
)

#######################################################################
# RDMA 测试端口网段名称
# 与 STORNETS 中冒号前的名称保持一致，可配置多个
#######################################################################
PTNETS=(
    net1
    net2
)
